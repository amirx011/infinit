<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <application
        android:label="Infinit Lab"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
        </activity>

        <!-- Hands every launcher-alias start to MainActivity and finishes, so
             no task is owned by an alias.  noHistory keeps it out of the back
             stack without hiding the task from recents. -->
        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:noHistory="true"
            android:theme="@style/LaunchTheme" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
            One launcher alias per accent palette.  Android cannot recolor a
            launcher icon at runtime, so the app enables the alias whose icon
            matches the palette chosen in settings.

            LauncherIndigo is the only alias enabled in the manifest, so a
            fresh install shows the default icon.  Every alias targets the
            LauncherActivity trampoline instead of MainActivity: the task then
            never belongs to an alias, so an alias can be switched while the
            app is in front without closing the task.  LauncherIndigoAlt is an
            identical copy used after the first switch, so the manifest default
            for LauncherIndigo can stay "enabled" and still be turned off at
            runtime.
        -->
        <activity-alias
            android:name=".LauncherIndigo"
            android:targetActivity=".LauncherActivity"
            android:exported="true"
            android:enabled="true"
            android:icon="@mipmap/ic_launcher_indigo"
            android:roundIcon="@mipmap/ic_launcher_indigo_round"
            android:label="Infinit Lab">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherIndigoAlt"
            android:targetActivity=".LauncherActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_indigo"
            android:roundIcon="@mipmap/ic_launcher_indigo_round"
            android:label="Infinit Lab">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherRose"
            android:targetActivity=".LauncherActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_rose"
            android:roundIcon="@mipmap/ic_launcher_rose_round"
            android:label="Infinit Lab">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherOcean"
            android:targetActivity=".LauncherActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_ocean"
            android:roundIcon="@mipmap/ic_launcher_ocean_round"
            android:label="Infinit Lab">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherEmerald"
            android:targetActivity=".LauncherActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_emerald"
            android:roundIcon="@mipmap/ic_launcher_emerald_round"
            android:label="Infinit Lab">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherAmber"
            android:targetActivity=".LauncherActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_amber"
            android:roundIcon="@mipmap/ic_launcher_amber_round"
            android:label="Infinit Lab">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherGraphite"
            android:targetActivity=".LauncherActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_graphite"
            android:roundIcon="@mipmap/ic_launcher_graphite_round"
            android:label="Infinit Lab">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
