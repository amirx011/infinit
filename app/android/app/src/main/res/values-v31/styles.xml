<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ uses the platform splash screen; point it at the same
         branded backdrop and mark as the legacy launch drawable. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">#050810</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/launch_logo</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
